# International Motorsports daily ads - environment variable NAMES only.
# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- Description copy generation (optional) ---
# Only needed if description.provider = "openai" in config/config.json.
OPENAI_API_KEY=

# --- Publishing platform (choose one; none are wired until you pick) ---
# GoHighLevel / LeadConnector Social Planner
GHL_PRIVATE_INTEGRATION_TOKEN=
GHL_LOCATION_ID=

# Meta Graph API (Facebook Page + Instagram Business)
META_PAGE_ID=
META_IG_USER_ID=
META_ACCESS_TOKEN=

# LinkedIn
LINKEDIN_ORGANIZATION_URN=
LINKEDIN_ACCESS_TOKEN=

# Google Business Profile
GBP_LOCATION_NAME=
GBP_ACCESS_TOKEN=

# --- Optional notification on failure ---
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
